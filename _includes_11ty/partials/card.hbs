{{!--
Re-usable card for linking to posts
--}}

<article class="gh-card post {{#if data.feature_image}}with-image{{else}}no-image{{/if}}">
    <a class="gh-card-link" href="{{url}}">
        {{#if data.feature_image}}
            <img class="gh-card-image"
                srcset="{{data.feature_image}} 300w,
                        {{data.feature_image}} 600w,
                        {{data.feature_image}} 1000w,
                        {{data.feature_image}} 2000w"
                sizes="(max-width: 1000px) 400px, 700px"
                src="{{data.feature_image}}"
                alt="{{#if data.feature_image_alt}}{{data.feature_image_alt}}{{else}}{{data.title}}{{/if}}"
            />
        {{/if}}
        <div class="gh-card-content">
            <span class="gh-card-meta"><time datetime="{{htmlDateString date}}">{{readableDate date "d MMM yyyy"}}</time> <span class="bull">&bull;</span> {{readingTime templateContent}}</span>
            <h2 class="gh-card-title">{{data.title}}</h2>
            <p>{{#if data.description}}{{data.description}}{{else}}{{excerpt templateContent 140}}{{/if}}</p>
            <strong>Read more</strong>
        </div>
    </a>
</article>
