---
layout: layouts/default.hbs
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: "/tag/{{ tag | slugify }}/index.html"
eleventyComputed:
  title: "{{ tag }}"
bodyClass: tag-template
---
<header class="gh-hero">
  <div class="gh-hero-content">
    <h1>{{ tag }}</h1>
    {% set taggedPosts = collections.posts | postsWithTag(tag) %}
    {% set taggedCount = taggedPosts | length %}
    <p>A collection of {{ taggedCount }} {{ "post" if taggedCount == 1 else "posts" }}</p>
  </div>
</header>

<div class="gh-page">
  <div class="gh-container">

    <div class="gh-postfeed">
    {% for post in taggedPosts %}

      <article class="gh-card post {% if post.data.feature_image %}with-image{% else %}no-image{% endif %}">
        <a class="gh-card-link" href="{{ post.url }}">
          {% if post.data.feature_image %}
            <img class="gh-card-image"
              srcset="{{ post.data.feature_image }} 300w,
                      {{ post.data.feature_image }} 600w,
                      {{ post.data.feature_image }} 1000w,
                      {{ post.data.feature_image }} 2000w"
              sizes="(max-width: 1000px) 400px, 700px"
              src="{{ post.data.feature_image }}"
              alt="{{ post.data.feature_image_alt or post.data.title }}"
            />
          {% endif %}
          <div class="gh-card-content">
            <span class="gh-card-meta"><time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate("d MMM yyyy") }}</time> <span class="bull">&bull;</span> {{ post.templateContent | readingTime }}</span>
            <h2 class="gh-card-title">{{ post.data.title }}</h2>
            <p>{{ post.data.description or (post.templateContent | excerpt(140)) }}</p>
            <strong>Read more</strong>
          </div>
        </a>
      </article>

    {% endfor %}
    </div>

  </div>
</div>
